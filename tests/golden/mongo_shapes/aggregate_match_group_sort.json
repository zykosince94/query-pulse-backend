{
  "description": "Each stage in its own context: $match filter, $group expression, $sort literal, $limit value.",
  "op": "command",
  "ns": "shop.orders",
  "command": {
    "aggregate": "orders",
    "pipeline": [
      {
        "$match": {
          "status": "paid",
          "total": {
            "$gt": 10
          }
        }
      },
      {
        "$group": {
          "_id": "$customerId",
          "n": {
            "$sum": 1
          },
          "spent": {
            "$sum": "$total"
          }
        }
      },
      {
        "$sort": {
          "n": -1
        }
      },
      {
        "$limit": 5
      }
    ],

# Copy to .env for local development. Never commit .env.
QP_ENVIRONMENT=dev

# App database (compose service `app-db`, exposed on localhost:5432)
QP_DATABASE_URL=postgresql+psycopg://querypulse:querypulse@localhost:5432/querypulse

# python -c "import secrets; print(secrets.token_urlsafe(48))"
QP_SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
QP_SESSION_HTTPS_ONLY=false

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QP_FERNET_KEY=
# Several comma-separated keys rotate: the first encrypts, all decrypt.

# How long a connection test waits for a monitored database (seconds, max 60)
QP_SOURCE_CONNECT_TIMEOUT_SECONDS=5

# Logging: json (default) or text
QP_LOG_FORMAT=text
QP_LOG_LEVEL=INFO

# Extra origins allowed to make state-changing requests (comma-separated). The site's own
# origin is always allowed.
QP_ALLOWED_ORIGINS=

# Sign-in rate limit: this many failures per client within the window, then 429
QP_LOGIN_MAX_FAILURES=10
QP_LOGIN_WINDOW_SECONDS=300

# Generic plans: re-plan each source's busiest operations this often (seconds), and how many
QP_COLLECTOR_PLAN_SECONDS=300
QP_COLLECTOR_PLAN_TOP_N=20

# MongoDB: profiler entries read per cycle at most (the rest wait for the next), and how many
# read shapes per source keep their newest command in collector memory for explain (never
# stored, see docs/adr/0010-no-stored-query-values.md)
QP_COLLECTOR_PROFILE_MAX_ENTRIES=10000
QP_COLLECTOR_SAMPLE_CACHE_SIZE=500

# Findings: how often each source's rules run, over what window, when an index counts as
# unused, and when an open finding no longer seen resolves itself
QP_RULES_INTERVAL_SECONDS=60
QP_RULES_WINDOW_MINUTES=60
QP_RULES_UNUSED_INDEX_MIN_SPAN_SECONDS=3600
QP_RULES_UNUSED_INDEX_WINDOW_HOURS=24
QP_FINDING_RESOLVE_AFTER_SECONDS=3600

# AI assistant (off until an admin turns it on in Settings). The OpenAI base URL can point at a
# compatible gateway (OpenRouter: https://openrouter.ai/api/v1, with models like author/model:tag);
# the fake provider is for tests and is refused when QP_ENVIRONMENT=prod.
QP_OPENAI_BASE_URL=https://api.openai.com/v1
QP_AI_TIMEOUT_SECONDS=60
QP_AI_ALLOW_FAKE_PROVIDER=false

QP_ADMIN_USERNAME=admin
QP_ADMIN_PASSWORD=change-me-admin
QP_DEMO_ENABLED=true
QP_DEMO_USERNAME=demo
QP_DEMO_PASSWORD=change-me-demo

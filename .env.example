# Copy to .env for local development. Never commit .env.
QP_ENVIRONMENT=dev

# App database (compose service `app-db`, exposed on localhost:5432)
QP_DATABASE_URL=postgresql+psycopg://querypulse:querypulse@localhost:5432/querypulse

# python -c "import secrets; print(secrets.token_urlsafe(48))"
QP_SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
QP_SESSION_HTTPS_ONLY=false

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QP_FERNET_KEY=

QP_ADMIN_USERNAME=admin
QP_ADMIN_PASSWORD=change-me-admin
QP_DEMO_ENABLED=true
QP_DEMO_USERNAME=demo
QP_DEMO_PASSWORD=change-me-demo

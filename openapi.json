            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Id"
          },
          "tls_mode": {
            "default": "disable",
            "enum": [
              "disable",
              "require",
              "verify-full"
            ],
            "title": "Tls Mode",
            "type": "string"
          },
          "username": {
            "default": "",
            "maxLength": 120,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "engine",
          "host",
          "port",
          "database"
        ],
        "title": "ConnectionTestRequest",
        "type": "object"
      },
      "ConnectionTestResult": {
        "properties": {
          "capabilities": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/CapabilityOut"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConnectionErrorOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "server_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Server Version"
          }
        },
        "required": [
          "ok"
        ],
        "title": "ConnectionTestResult",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "unreachable",
          "timeout",
          "auth_failed",
          "tls",
          "database_not_found",
          "permission_denied",
          "unsupported_version",
          "unknown"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "Role": {
        "enum": [
          "admin",
          "demo"
        ],
        "title": "Role",
        "type": "string"
      },

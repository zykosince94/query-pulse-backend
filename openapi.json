        "type": "object"
      },
      "ConnectionTestRequest": {
        "properties": {
          "database": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Database",
            "type": "string"
          },
          "engine": {
            "$ref": "#/components/schemas/SourceEngine"
          },

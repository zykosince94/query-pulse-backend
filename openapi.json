{
  "components": {
    "schemas": {
      "AuthConfig": {
        "properties": {
          "demo_enabled": {
            "title": "Demo Enabled",
            "type": "boolean"
          }
        },
        "required": [
          "demo_enabled"
        ],
        "title": "AuthConfig",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "Role": {
        "enum": [
          "admin",
          "demo"
        ],
        "title": "Role",
        "type": "string"
      },
      "SourceConnectionRequest": {
        "properties": {
          "database": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Database",
            "type": "string"
          },
          "host": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Host",
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "minLength": 2,
            "title": "Name",
            "type": "string"
          },
          "password": {
            "default": "",
            "format": "password",
            "title": "Password",
            "type": "string",
            "writeOnly": true
          },
          "port": {
            "maximum": 65535.0,
            "minimum": 1.0,
            "title": "Port",
            "type": "integer"
          },
          "ssl": {
            "default": false,
            "title": "Ssl",
            "type": "boolean"
          },
          "type": {
            "$ref": "#/components/schemas/SourceType"
          },
          "username": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "name",
          "type",
          "host",
          "port",
          "database",
          "username"
        ],
        "title": "SourceConnectionRequest",
        "type": "object"
      },
      "SourceCreate": {
        "properties": {
          "database": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Database",
            "type": "string"
          },
          "description": {
            "default": "",
            "title": "Description",
            "type": "string"
          },
          "enabled": {
            "default": true,
            "title": "Enabled",
            "type": "boolean"
          },
          "host": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Host",
            "type": "string"
          },
          "id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "minLength": 2,
            "title": "Name",
            "type": "string"
          },
          "password": {
            "default": "",
            "format": "password",
            "title": "Password",
            "type": "string",
            "writeOnly": true
          },
          "port": {
            "maximum": 65535.0,
            "minimum": 1.0,
            "title": "Port",
            "type": "integer"
          },
          "ssl": {
            "default": false,
            "title": "Ssl",
            "type": "boolean"
          },
          "type": {
            "$ref": "#/components/schemas/SourceType"
          },
          "username": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "host",
          "port",
          "database",
          "username"
        ],
        "title": "SourceCreate",
        "type": "object"
      },
      "SourceHealth": {
        "properties": {
          "engine": {
            "$ref": "#/components/schemas/SourceType"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "status",
          "engine",
          "ready",
          "message"
        ],
        "title": "SourceHealth",
        "type": "object"
      },
      "SourceOut": {
        "description": "What the API returns. Credentials are never included, only whether one is set.",
        "properties": {
          "database": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Database",
            "type": "string"
          },
          "description": {
            "default": "",
            "title": "Description",
            "type": "string"
          },
          "enabled": {
            "default": true,
            "title": "Enabled",
            "type": "boolean"
          },
          "has_password": {
            "title": "Has Password",
            "type": "boolean"
          },
          "host": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Host",
            "type": "string"
          },
          "id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "minLength": 2,
            "title": "Name",
            "type": "string"
          },
          "port": {
            "maximum": 65535.0,
            "minimum": 1.0,
            "title": "Port",
            "type": "integer"
          },
          "ssl": {
            "default": false,
            "title": "Ssl",
            "type": "boolean"
          },
          "type": {
            "$ref": "#/components/schemas/SourceType"
          },
          "username": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "host",
          "port",
          "database",
          "username",
          "has_password"
        ],
        "title": "SourceOut",
        "type": "object"
      },
      "SourceType": {
        "enum": [
          "postgres",
          "mongodb"
        ],
        "title": "SourceType",
        "type": "string"
      },
      "UserOut": {
        "properties": {
          "read_only": {
            "title": "Read Only",
            "type": "boolean"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "role",
          "read_only"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Query Pulse backend.",
    "title": "Query Pulse API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/config": {
      "get": {
        "description": "Public: what the sign-in screen should offer.",
        "operationId": "getAuthConfig",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthConfig"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Auth Config",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/demo": {
      "post": {
        "description": "Public: sign in as the read-only demo user without a password (\"Try the demo\").\n\nSafe because the demo user can't change anything (every write returns 403) and the\nendpoint only works when the operator enabled the demo with QP_DEMO_ENABLED.",
        "operationId": "loginAsDemo",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Login As Demo",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/collector/status": {
      "get": {
        "operationId": "getCollectorStatus",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Getcollectorstatus",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Collector Status",
        "tags": [
          "sources"
        ]
      }
    },
    "/api/sources": {
      "get": {
        "operationId": "listSources",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Listsources",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Sources",
        "tags": [
          "sources"
        ]
      },
      "post": {
        "operationId": "createSource",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Source",
        "tags": [
          "sources"
        ]
      }
    },
    "/api/sources/test": {
      "post": {
        "operationId": "testSourceConnection",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceConnectionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Testsourceconnection",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Test Source Connection",
        "tags": [
          "sources"
        ]
      }
    },
    "/api/sources/{source_id}/health": {
      "get": {
        "operationId": "getSourceHealth",
        "parameters": [
          {
            "in": "path",
            "name": "source_id",
            "required": true,
            "schema": {
              "title": "Source Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceHealth"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Source Health",
        "tags": [
          "sources"
        ]
      }
    },
    "/api/sources/{source_id}/workload-preview": {
      "get": {
        "operationId": "getWorkloadPreview",
        "parameters": [
          {
            "in": "path",
            "name": "source_id",
            "required": true,
            "schema": {
              "title": "Source Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Getworkloadpreview",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Workload Preview",
        "tags": [
          "sources"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Liveness: the process is up.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "ops"
        ]
      }
    },
    "/ready": {
      "get": {
        "description": "Readiness: the app database answers.",
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "ops"
        ]
      }
    }
  }
}

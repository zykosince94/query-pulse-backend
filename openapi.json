  "components": {
    "schemas": {
      "AuthConfig": {
        "properties": {
          "demo_enabled": {
            "title": "Demo Enabled",
            "type": "boolean"
          }
        },
        "required": [
          "demo_enabled"
        ],
        "title": "AuthConfig",
        "type": "object"
      },
      "CapabilityOut": {
        "properties": {
          "available": {
            "title": "Available",
